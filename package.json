{
  "name": "lab_4",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint \"MongooseJsTemplate-main/**/*.js\" --fix",
    "lint:check": "eslint \"MongooseJsTemplate-main/**/*.js\"",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "testMatch": [
      "**/MongooseJsTemplate-main/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "MongooseJsTemplate-main/controllers/**/*.js",
      "MongooseJsTemplate-main/models/**/*.js",
      "MongooseJsTemplate-main/routes/**/*.js",
      "MongooseJsTemplate-main/config/**/*.js",
      "!MongooseJsTemplate-main/config/swagger.config.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "roots": ["<rootDir>/MongooseJsTemplate-main"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "mongodb": "3.7",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
